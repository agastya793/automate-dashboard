# Backend Environment Configuration

# Runtime environment label
ENVIRONMENT=development

# Server binding
HOST=127.0.0.1
PORT=8000

# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Phase 2 upload resource limits (override defaults as needed)
# NOTE: If modifying MAX_UPLOAD_BYTES, also update NEXT_PUBLIC_MAX_UPLOAD_BYTES in frontend/.env.example
# MAX_UPLOAD_BYTES=10485760    # 10 MB (default)
# MAX_DATA_ROWS=50000
# MAX_COLUMNS=100
# MAX_PREVIEW_ROWS=20
