# Backend Environment Configuration (Milestone 3)

# Runtime environment (development | production)
APP_ENV=development
ENVIRONMENT=development

# Server binding (loopback default for local security)
HOST=127.0.0.1
PORT=8000

# Local Single-User Development Mode
# Enables local developer context when authentication is not configured.
# Note: Prohibited by startup guard if APP_ENV=production.
SINGLE_USER_DEV_MODE=true

# Storage Abstraction (Milestone 3: Local Filesystem Default - No AWS/Cloud Required)
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=data/storage

# Metadata Database (Local PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/reporting_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=reporting_db

# Background Task Queue (Local Redis 7 & Celery)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=false
CELERY_WORKER_CONCURRENCY=2

# CORS Allowed Origins (Comma-separated exact origins, no wildcards when credentials enabled)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authentication & Session Security (Milestone 5)
# Session lifetime in seconds (default 86400 = 24 hours)
SESSION_LIFETIME_SECONDS=86400

# Registration policy (true for development, disable in production until verification is configured)
ALLOW_REGISTRATION=true

# Cookie configuration (Set COOKIE_SECURE=true and HTTPS in production)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Upload Resource Limits
MAX_UPLOAD_BYTES=10485760    # 10 MB default (configurable up to 52428800 for 50 MB)
MAX_DATA_ROWS=50000
MAX_COLUMNS=100
MAX_PREVIEW_ROWS=20

