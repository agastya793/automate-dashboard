# Frontend Environment Configuration

# URL of the backend FastAPI service
# The default avoids common local port collisions. Override if needed.
NEXT_PUBLIC_API_BASE_URL=http://localhost:18001

# Client-side max upload limit in bytes (must match backend MAX_UPLOAD_BYTES; default: 10 MB = 10485760 bytes)
NEXT_PUBLIC_MAX_UPLOAD_BYTES=10485760

# Authentication & Sessions
# Native FastAPI session cookies and CSRF tokens are handled automatically via browser cookies.
# No Supabase or third-party cloud credentials are required.

