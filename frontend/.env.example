# Frontend Environment Configuration

# URL of the backend FastAPI service
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Client-side max upload limit in bytes (must match backend MAX_UPLOAD_BYTES; default: 10 MB = 10485760 bytes)
NEXT_PUBLIC_MAX_UPLOAD_BYTES=10485760

# Phase 5: Supabase Auth, PostgreSQL, & Storage Configuration
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
